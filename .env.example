# =========================
# ===  GÉNÉRAL           ===
# =========================
LOG_LEVEL="INFO"
FLASK_SECRET_KEY="__remplacer_par_un_secret_long__"
REDIS_URL="redis://redis:6379"

# =========================
# ===  DISCORD           ===
# =========================
DISCORD_TOKEN="__discord_bot_token__"
DISCORD_CLIENT_ID="__discord_app_id__"
DISCORD_CLIENT_SECRET="__discord_client_secret__"
DISCORD_OAUTH_SCOPES="identify guilds"
DISCORD_REDIRECT_URI="https://__ton_domaine__/api/v1/auth/callback"
GREG_OWNER_ID="__ton_id_discord__"
DEFAULT_GUILD_ID=""

# =========================
# ===  SESSIONS          ===
# =========================
SESSION_COOKIE_NAME="gregsid"
SESSION_COOKIE_SAMESITE="None"
SESSION_COOKIE_SECURE="1"

# =========================
# ===  PRIORITÉ          ===
# =========================
PRIORITY_THRESHOLD="50"
PRIORITY_ROLE_WEIGHTS='{"DJ":80,"VIP":60,"Booster":45,"__DEFAULT__":10}'
QUEUE_PER_USER_CAP="10"

# =========================
# ===  MUSIQUE / YOUTUBE ===
# =========================
GREG_JOIN_SFX_DELAY="2.5"

# Nombre max de titres ajoutés depuis un lien playlist/mix/set (le quota par
# utilisateur QUEUE_PER_USER_CAP peut réduire encore ce nombre).
PLAYLIST_EXPAND_LIMIT="25"

# PO Token YouTube (optionnel). Format brut OU préfixé "client.gvs+TOKEN" (ex: mweb.gvs+abc…).
YT_PO_TOKEN=""
YT_PO_TOKEN_PREFIXED=""
# Auto-fetch des PO tokens via Playwright/Chromium : désactivé par défaut (lent,
# ~25 s par tentative, rarement utile avec les clients `tv`). "1" pour l'activer.
YT_PO_AUTOFETCH="0"

# Stratégie réseau yt-dlp
YTDLP_FORCE_IPV4="1"
YTDLP_AUTO_PIPE_ON_403="1"

# Ordre des clients YouTube (vide → défaut: tv,tv_simply,mweb,web_safari,ios,android,web)
# `tv`/`tv_simply` ne nécessitent ni PO token ni cookies → recommandés en 2026.
YTDLP_CLIENTS=""

# Cookies YouTube — au choix : fichier path, base64, ou navigateur local
# YTDLP_COOKIES_FILE = LE chemin unique du fichier cookies (Netscape) :
#   - lu par yt-dlp à chaque extraction (résolu à chaque appel) ;
#   - écrit par /yt_cookies_update ;
#   - YTDLP_COOKIES_B64 y est décodé (gzip ou texte) seulement si le fichier est absent.
#   Défaut : "youtube.com_cookies.txt" (relatif au dossier du bot, /app en Docker).
#   YOUTUBE_COOKIES_PATH reste accepté comme alias legacy si YTDLP_COOKIES_FILE est vide.
#   ⚠ Rotation de YTDLP_COOKIES_B64 : le B64 n'écrase JAMAIS un fichier existant (ni un
#   upload /yt_cookies_update, ni le fichier que yt-dlp réécrit après chaque extraction).
#   Sur un chemin persistant (volume, ex: /app/data/… = volume bot-data en compose),
#   un nouveau YTDLP_COOKIES_B64 n'est donc PAS appliqué au redéploiement. Le plus simple :
#   envoyer les cookies via /yt_cookies_update (owner). Sinon : mettre à jour le B64,
#   redéployer, PUIS supprimer le fichier (ex: `docker compose exec bot rm
#   /app/data/youtube.com_cookies.txt`) → recréé depuis le nouveau B64 à l'extraction
#   suivante, sans redémarrage. Supprimé avant, l'ancien bot (ancien B64) le recréerait.
#   Avec le défaut (fichier dans le conteneur), le B64 est réappliqué à chaque nouveau
#   conteneur (redeploy Railway, `docker compose up -d` après changement du .env).
# Chemin persistant (garde les uploads /yt_cookies_update entre redéploiements) :
# YTDLP_COOKIES_FILE="/app/data/youtube.com_cookies.txt"
# YTDLP_COOKIES_B64=""
# YTDLP_COOKIES_BROWSER="chrome"  # ex: chrome | firefox | edge

# Build de l'image bot : yt-dlp est réinstallé (pip -U) à chaque commit déployé
# sur Railway. Pour forcer une mise à jour sans commit, changer cette valeur
# (variable Railway du service bot, ou `YTDLP_REFRESH=$(date +%F) docker compose build bot`).
# YTDLP_REFRESH=""

# =========================
# ===  PO TOKEN FETCHER  ===
# =========================
# Utilisé seulement si YT_PO_AUTOFETCH="1".
# Le fetcher Playwright met les échecs structurels en cache négatif pour
# éviter de tenter en boucle quand Chromium est absent.
PO_NEG_TTL_SEC="600"        # durée du cache négatif (secondes)
PO_CACHE_TTL_SEC="1800"     # durée du cache positif (PO valide) par vidéo
# Auto-installation Chromium si manquant (utile en dev, déconseillé en prod
# car ralentit le 1er play et nécessite root) :
# PLAYWRIGHT_AUTOINSTALL="0"
# PLAYWRIGHT_HEADLESS="1"

# =========================
# ===  SPOTIFY           ===
# =========================
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="https://__ton_domaine__/api/v1/spotify/callback"
SPOTIFY_SCOPES="user-read-email playlist-read-private playlist-read-collaborative playlist-modify-public playlist-modify-private"
SPOTIFY_STATE_SECRET="__remplacer__"

# =========================
# ===  SOUNDCLOUD        ===
# =========================
SOUNDCLOUD_CLIENT_ID=""

# =========================
# ===  SPOOK             ===
# =========================
SPOOK_MIN_DELAY="30"
SPOOK_MAX_DELAY="120"
SPOOK_VOLUME="0.30"

# =========================
# ===  VOICE AI (futur)  ===
# =========================
# ANTHROPIC_API_KEY=""
# ELEVENLABS_API_KEY=""
# WHISPER_MODEL="base"

# =========================
# ===  FRONT             ===
# =========================
# Valeurs de BUILD (figées au `next build`) : passées en build args par
# docker-compose (services.web.build.args) ; sur Railway, variables du service web.
# NEXT_PUBLIC_* sont lues par le navigateur → URL joignable depuis l'hôte.
# NEXT_PUBLIC_API_URL : ignorée sur *.railway.app ou si injoignable (→ '/api/v1'
# relatif, rewrite Next vers API_URL) ; aucun repli implicite vers l'API de prod.
# NEXT_PUBLIC_WS_URL : docker-compose la force à vide (ignore ce .env) → le socket
# suit la base REST (même backend). Si définie (Railway), elle doit viser la MÊME
# API que les appels REST, sinon l'UI mélange deux files d'attente.
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="http://localhost:3000"
# Cible des rewrites /api et /socket.io (côté serveur Next). docker-compose force
# http://api:3000 ; défaut hors compose : http://api.railway.internal:3000.
# API_URL="http://api.railway.internal:3000"
